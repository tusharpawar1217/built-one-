# Gemini API
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash-8b
GEMINI_MODEL_PRO=gemini-1.5-pro

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sarkari_ai
POSTGRES_USER=sarkari_user
POSTGRES_PASSWORD=change_me_in_production

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# S3-compatible storage (Backblaze B2)
S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET_NAME=sarkari-ai-pdfs
S3_REGION=us-west-002

# JWT
JWT_SECRET=change_this_to_a_secure_random_string
JWT_EXPIRY_HOURS=24

# Rate Limiting
FREE_TIER_QUERIES_PER_DAY=3
FREE_TIER_PAGES_PER_MONTH=50
PREMIUM_TIER_QUERIES_PER_DAY=999999
PREMIUM_TIER_PAGES_PER_MONTH=999999

# Services
RAG_SERVICE_URL=http://localhost:8000
CORE_SERVICE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# ML Models
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-base
EMBEDDING_DIMENSION=1024

# OCR
TESSERACT_CMD=tesseract
OCR_LANGUAGES=eng+hin+mar

# Feature Flags
ENABLE_OCR=true
ENABLE_RERANKER=true
ENABLE_QUIZ_GENERATION=false
ENABLE_ELIGIBILITY_EXTRACTION=false

# Logging
LOG_LEVEL=INFO
